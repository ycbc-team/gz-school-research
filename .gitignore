# macOS
.DS_Store

# 编辑器/IDE
.idea/
.vscode/
*.swp

# 临时文件
*.tmp
*.bak
*.preview
~$*

# 隐私与敏感信息
*.key
*.pem
.env

# 日志
*.log

# Node / monorepo
node_modules/
dist/
*.tsbuildinfo
.pnpm-store/

# 微信小程序构建产物（由 scripts/miniprogram/build.mjs 从 data/ JSON 与 packages/shared 生成）
apps/miniprogram/shared/
apps/miniprogram/data/
apps/miniprogram/miniprogram_npm/

# 微信开发者工具个人配置
project.private.config.json

# linkage OCR/诊断中间图（数据保留在磁盘，不进 git）
data/linkage/raw/headers/*.png
data/linkage/raw/*.png
data/linkage/raw/*.preview

# 高中录取分官方页原始 HTML（scripts/high/build_scores.py --fetch 可重新抓取；真源只存 JSON）
data/high/raw/

# Web 紧凑数据产物（由 scripts/data/compact.mjs 从 data/ JSON 编译，加载后 hydrate 还原）
apps/web/src/data/compact/

# 小程序分包紧凑数据产物（同主包，由 build:mp 生成）
apps/miniprogram/pages/school-detail/data/
