{
  "name": "@gz/shared",
  "version": "0.1.0",
  "description": "广州学校升学调研 · 双端共享核心包（类型 + 纯逻辑，零平台依赖）",
  "type": "module",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/esm/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "node build.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node build.mjs && node --test tests/*.test.cjs"
  },
  "devDependencies": {
    "typescript": "^5.5.0"
  }
}
