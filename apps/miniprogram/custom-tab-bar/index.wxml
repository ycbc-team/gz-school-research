<view class="tabbar" style="display:{{hidden ? 'none' : 'flex'}}">
  <view
    wx:for="{{list}}"
    wx:key="index"
    class="tab {{selected === index ? 'on' : ''}}"
    data-path="{{item.pagePath}}"
    data-index="{{index}}"
    bindtap="switchTab"
  >
    <view class="tx">{{item.text}}</view>
  </view>
</view>
