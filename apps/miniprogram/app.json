{
  "pages": [
    "pages/index/index",
    "pages/school/school",
    "pages/policy/policy"
  ],
  "subpackages": [
    {
      "root": "pages/school-detail",
      "pages": [
        "index"
      ]
    }
  ],
  "window": {
    "navigationBarTitleText": "广州学校升学调研",
    "navigationBarBackgroundColor": "#F4F3EE",
    "navigationBarTextStyle": "black",
    "backgroundColor": "#F4F3EE"
  },
  "tabBar": {
    "custom": true,
    "color": "#8A93A6",
    "selectedColor": "#2F5CD6",
    "backgroundColor": "#FFFFFF",
    "borderStyle": "white",
    "list": [
      { "pagePath": "pages/index/index", "text": "首页" },
      { "pagePath": "pages/school/school", "text": "学校" }
    ]
  },
  "sitemapLocation": "sitemap.json",
  "preloadRule": {
    "pages/index/index": {
      "network": "all",
      "packages": ["pages/school-detail"]
    }
  },
  "permission": {
    "scope.userLocation": {
      "desc": "用于在地图上展示你附近的学校并帮你定位筛选"
    }
  },
  "requiredPrivateInfos": ["getLocation"]
}
