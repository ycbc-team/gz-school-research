.page { padding: 32rpx; min-height: 100vh; background: #F5F7FB; }
.hero { padding: 16rpx 0 24rpx; }
.kicker {
  display: inline-flex; align-items: center; gap: 8rpx;
  font-size: 22rpx; font-weight: 600; letter-spacing: .08em;
  color: #254BAE; background: #F2F6FE; border: 1rpx solid #E2EBFB;
  padding: 6rpx 18rpx; border-radius: 999px; margin-bottom: 16rpx;
}
.hero .title { font-size: 44rpx; font-weight: 700; line-height: 1.3; color: #10182B; }
.hero .sub { margin-top: 12rpx; font-size: 26rpx; color: #64708C; }

.note {
  margin: 8rpx 0 24rpx; background: #FFFBEB; border: 1rpx solid #FCE9B8;
  border-left: 6rpx solid #E3902F; border-radius: 16rpx; padding: 20rpx 24rpx;
  font-size: 24rpx; color: #6B5220;
}
.note b { color: #8A6413; }

.sec { margin-bottom: 28rpx; }
.sec-title {
  font-size: 28rpx; font-weight: 600; color: #10182B;
  margin-bottom: 14rpx; padding-left: 18rpx; position: relative;
}
.sec-title::before {
  content: ""; position: absolute; left: 0; top: 6rpx; bottom: 6rpx;
  width: 6rpx; border-radius: 3rpx; background: #2F5CD6;
}
.card { background: #fff; border: 1rpx solid #E3E8F0; border-radius: 20rpx; padding: 12rpx 28rpx; }
.line { font-size: 26rpx; color: #33405C; line-height: 1.8; padding: 16rpx 0; border-bottom: 1rpx solid #EFF2F7; }
.line:last-child { border-bottom: none; }
