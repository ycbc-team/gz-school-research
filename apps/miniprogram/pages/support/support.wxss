.page { padding: 24rpx; }
.toolbar { display: flex; flex-wrap: wrap; align-items: center; gap: 16rpx; margin-bottom: 20rpx; }
.chip {
  border: 1rpx solid #d6d4cc; background: #fff; color: #1a1b1c;
  border-radius: 999rpx; padding: 10rpx 28rpx; font-size: 26rpx;
}
.chip.active { background: #3a5396; border-color: #3a5396; color: #fff; }
.summary { font-size: 22rpx; color: #6b7280; }

.cards { display: flex; flex-direction: column; gap: 20rpx; }
.card { background: #fff; border: 1rpx solid #e4e3dd; border-radius: 20rpx; padding: 28rpx; }
.card-head { display: flex; justify-content: space-between; align-items: flex-start; gap: 16rpx; }
.card-name { font-size: 30rpx; font-weight: 600; line-height: 1.4; }
.badge { flex-shrink: 0; color: #fff; font-size: 22rpx; font-weight: 600; border-radius: 999rpx; padding: 4rpx 20rpx; }
.badge-supported { background: #2f7d1f; }
.badge-partial { background: #b07d1f; }
.badge-unsupported { background: #c9534f; }
.tier { font-size: 24rpx; color: #6b7280; margin-top: 12rpx; }
.basis { font-size: 24rpx; color: #444; margin-top: 8rpx; line-height: 1.6; }
