/* 学校卡组件（半窗 / 全屏 单层级）。样式隔离：本文件定义卡片容器 + 详情模块全部类。 */

/* ===== 根容器 ===== */
.scard {
  display: flex; flex-direction: column;
  background: #fff;
  box-shadow: 0 -12rpx 44rpx rgba(8,14,28,.22);
  transition: height .22s ease-out, border-radius .22s ease-out;
}
/* overlay：浮于地图页之上（底部对齐），z-index 压过地图与图例 */
.scard.overlay {
  position: absolute; left: 0; right: 0; bottom: 0; z-index: 200;
  border-radius: 36rpx 36rpx 0 0;
  padding-bottom: calc(env(safe-area-inset-bottom) + 12rpx);
}
.scard.overlay.dragging { transition: none; }       /* 跟手：关过渡 */
/* 全屏态：去掉 top:0、始终 bottom:0 锚定 + 像素高度（见 updateStyle 用 winH px），
   保证「从底部 45% 向上延展到全屏 / 从全屏向下收回到半窗」几何正确、过渡动画平滑；
   若在此写 top:0 会与 bottom:0 形成 over-constraint，导致全屏几何错乱、露出地图。顶栏 .stop 高度见下方 07 规格。 */
.scard.overlay.full { height: 100%; border-radius: 0; padding-bottom: 0; }
/* 半窗态内容容器：包住 grabber / 内容 / 展开胶囊，单独承载 catchtouchmove（驱动跟手展开 +
   阻止透给原生 map），且不作为全屏 scroll-view 的祖先（否则拦截其滚动）。 */
.halfbody { position: relative; flex: 1; min-height: 0; display: flex; flex-direction: column; }
/* page：详情页整屏宿主，始终全屏 */
.scard.page {
  position: fixed; left: 0; right: 0; top: 0; bottom: 0; z-index: 1;
  height: 100%;
}

/* ===== 全屏态顶栏（返回 + 标题）—— 严格按 UI 稿 07 .dtop ===== */
/* .stop = 状态栏占位 + 64px 内容行（上下 14px + 36px 按钮）；border-bottom 紧贴内容行下沿 */
.stop {
  position: relative; flex: none;
  background: #fff; border-bottom: 1px solid #E3E8F0;
}
/* 返回按钮：36px 圆（UI 稿尺寸）；底边与胶囊底边对齐（行内 top 给出）。 */
/* 返回按钮外圈：与右侧原生胶囊完全对齐（用户要求）——尺寸=胶囊高（wxml 行内 width/height=capH，
   此处 32px 为兜底）、top=capTop（上下沿分别对齐胶囊最高/最低点）；描边为淡墨色细线圈、无底色，
   对齐小程序胶囊「描边圆圈无底色」风格（比旧版 0.28 更浅） */
.sback {
  position: absolute; left: 16px; width: 32px; height: 32px; border-radius: 50%;
  background: transparent; border: 1px solid rgba(51,64,92,0.10);
  display: flex; align-items: center; justify-content: center;
}
/* 返回箭头：CSS 绘制的左向 chevron，以 32px 胶囊为基准设计（wxml 按 capH/32 行内 scale 适配）。
   两臂 ±45° 实心细条交于左中点，top:50% 垂直天然居中，left:1px 使水平视觉重心（顶点 x=1、臂端 x≈10，中点≈5.5）落在 11px 盒中心。 */
.sback-chev { position: relative; width: 11px; height: 11px; }
.sback-chev::before, .sback-chev::after {
  content: ''; position: absolute; left: 1px; top: 50%;
  width: 9px; height: 2px; background: #33405C; border-radius: 2px;
  transform-origin: left center;
}
.sback-chev::before { transform: translateY(-50%) rotate(45deg); }
.sback-chev::after  { transform: translateY(-50%) rotate(-45deg); }
/* 标题：绝对居中（UI 稿 .tt：left:50% 平移居中、max-width 196px、单行省略），
   top/height/line-height 由行内样式按胶囊实测坐标给出（与胶囊垂直同中心），此处为兜底值 */
.stt {
  position: absolute; left: 50%; transform: translateX(-50%); max-width: 196px;
  height: 32px; line-height: 32px; text-align: center;
  font-size: 16px; font-weight: 600; color: #10182B;
  white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
}

/* ===== 半窗态 grabber + 关闭 ===== */
.sgrab {
  flex: none; width: 72rpx; height: 8rpx; border-radius: 4rpx; background: #E3E8F0;
  margin: 14rpx auto 12rpx;
}
.sclose {
  position: absolute; top: 14rpx; right: 22rpx; width: 56rpx; height: 56rpx; line-height: 52rpx; text-align: center;
  border-radius: 50%; background: #F2F4F8; color: #5A647C; font-size: 40rpx; font-weight: 600; z-index: 3;
}
/* 透明手势兜底区：卡片顶缘上方 ~56px（仅 overlay 半窗态），扩张卡片自身的手势接管范围，
   防止"擦着卡片上沿起手"的滑动漏给原生地图导致地图平移；无背景故不显白条、不挡地图。 */
.sgrabzone {
  position: absolute; left: 0; right: 0; top: -56px; height: 56px;
}

/* ===== 多学段 tab 条（UI 稿 .stagebar/.stab，半窗 06C 与全屏 07B 同款） ===== */
/* 大胶囊：等分拉伸占满整行（spec: .stab{flex:1}）、高 34px、白底灰边、选中浅蓝底+蓝边蓝字 */
.stagebar {
  flex: none; display: flex; gap: 20rpx; margin: 20rpx 32rpx 8rpx; padding: 0; background: transparent;
}
.stab {
  flex: 1; display: flex; align-items: center; justify-content: center; height: 68rpx; padding: 0 20rpx;
  border-radius: 999px; border: 1rpx solid #E3E8F0; background: #fff;
  font-size: 27rpx; font-weight: 600; color: #8B96AD; box-sizing: border-box;
}
.stab.on { background: #F2F6FE; border-color: #98B6EC; color: #254BAE; }
/* 半窗态：handle 之下、校名之上，行距与 06C「handle → 学段 tab → 校名」统一；
   padding-right 让出右上角关闭按钮（right:22rpx+56rpx 宽=左缘 78rpx 处）的占位，避免 tab 与 ✕ 重叠 / 误触 */
.stagebar.inhalf { margin: 4rpx 32rpx 12rpx; padding-right: 54rpx; box-sizing: content-box; }

/* ===== 内容区 ===== */
.sclip { position: relative; flex: 1; min-height: 0; overflow: hidden; padding: 0 32rpx; }
/* 全屏滚动容器：scroll-view 绝对铺满 → 高度为像素级确定，
   不依赖 flex/百分比推导（scroll-view 高度不确定时真机会直接不滚） */
.sfullwrap { position: relative; flex: 1; min-height: 0; }
.sscroll { position: absolute; left: 0; right: 0; top: 0; bottom: 0; padding: 4rpx 32rpx 0; box-sizing: border-box; }
/* 全屏滚动容器隐藏滚动条：enhanced + show-scrollbar=false 的兜底（官方隐藏滚动条方案 + CSS 双保险） */
.sscroll::-webkit-scrollbar { display: none; width: 0; height: 0; color: transparent; }
.sfade {
  position: absolute; left: 0; right: 0; bottom: 0; height: 120rpx;
  background: linear-gradient(to bottom, rgba(255,255,255,0), #fff 80%); pointer-events: none;
}
/* 展开详情：实心蓝色高亮胶囊（右下角，叠于渐隐区之上），带向下箭头，投影突出 */
.smore {
  position: absolute; right: 24rpx; bottom: calc(env(safe-area-inset-bottom) + 24rpx); z-index: 5;
  height: 76rpx; padding: 0 36rpx; border-radius: 999px;
  background: #2F5CD6; color: #fff; font-size: 28rpx; font-weight: 700;
  display: flex; align-items: center; gap: 10rpx;
  box-shadow: 0 8rpx 22rpx rgba(47,92,214,.34);
}
.smore-caret {
  width: 0; height: 0; margin-top: 4rpx;
  border-left: 10rpx solid transparent; border-right: 10rpx solid transparent;
  border-top: 12rpx solid #fff;
}
.pad-bottom { height: calc(env(safe-area-inset-bottom) + 24px); }

/* ===== 详情模块（与详情页 07 同规格） ===== */
.dh1 { font-size: 40rpx; font-weight: 700; margin-top: 8rpx; color: #10182B; }
.dtags { display: flex; gap: 12rpx; margin-top: 20rpx; flex-wrap: wrap; }

.dmod { margin-top: 36rpx; padding-top: 30rpx; border-top: 1rpx solid #E3E8F0; }
.dmod-h { display: flex; align-items: baseline; justify-content: space-between; gap: 20rpx; margin-bottom: 8rpx; }
.dmod-h-t { font-size: 30rpx; font-weight: 700; color: #33405C; }
.dmod-h .dmod-meta { margin-left: auto; flex: none; font-size: 22rpx; font-weight: 400; color: #8B96AD; }

/* 字段行：左字段名定宽（宽度须容纳最长字段名「省市属高中录取名额」9 字 ≈ 234rpx，
   否则 nowrap 溢出会把间距吃掉、看起来「名字和值贴在一起」）、右侧填充值，两者间距放宽 */
.kv { display: flex; gap: 48rpx; padding: 14rpx 0; font-size: 26rpx; line-height: 1.6; }
.kv .k { width: 260rpx; flex: none; white-space: nowrap; color: #64708C; }
.kv .v { flex: 1; min-width: 0; color: #33405C; }

.zone { font-size: 25rpx; line-height: 1.6; color: #33405C; white-space: pre-line; }

.route { display: flex; align-items: center; gap: 16rpx; padding: 14rpx 0; font-size: 25rpx; font-weight: 600; color: #33405C; }
.route .lk, .grp-row .lk, .trow .lk { display: inline-flex; align-items: center; gap: 8rpx; color: #2F5CD6; }
.route .lk::after, .grp-row .lk::after, .trow .lk::after { content: "›"; font-size: 30rpx; line-height: 1; margin-top: -4rpx; opacity: .7; }

.route-block { margin-top: 24rpx; }
.route-h { display: flex; align-items: center; gap: 16rpx; margin: 8rpx 0 14rpx; font-size: 26rpx; font-weight: 700; color: #33405C; }
.route-h .rh-n { font-weight: 700; }
.route-h .tag { margin: 0; flex: none; }

.dnote { font-size: 22rpx; color: #8B96AD; background: #F5F7FB; border-radius: 16rpx; padding: 16rpx 20rpx; margin-top: 16rpx; line-height: 1.6; }

.grp-t { font-size: 26rpx; font-weight: 700; color: #33405C; margin: 28rpx 0 14rpx; }
.grpbox { background: #FAFBFC; border: 1rpx solid #EFF2F7; border-radius: 20rpx; padding: 16rpx 24rpx 20rpx; }
.grp-l { font-size: 26rpx; font-weight: 600; color: #64708C; margin: 12rpx 0 4rpx; }
.grp-row { display: flex; align-items: center; gap: 16rpx; padding: 14rpx 0; font-size: 25rpx; font-weight: 600; color: #33405C; }
/* 关联校区 / 分组行：标签【紧跟校名】、不右对齐（gap 即固定间距）；
   校名 flex:0 1 auto —— 名字短就按实际字数展示、标签紧随其后，标签多/名字长时才收缩截断，始终单行不换行 */
.grp-row .gn { flex: 0 1 auto; min-width: 0; overflow: hidden; }

.pill { height: 52rpx; padding: 0 24rpx; border-radius: 999px; font-size: 23rpx; font-weight: 600; display: inline-flex; align-items: center; flex: none; }
.pill.cur { background: #F2F6FE; color: #254BAE; border: 1rpx solid #C9D8F5; }

.dsub { font-size: 26rpx; font-weight: 400; color: #64708C; margin: 20rpx 0 4rpx; }
.ddiv { border-top: 3rpx dashed #E3E8F0; margin: 24rpx 0 8rpx; }

/* 表单统一规范：表头与数据行共用同一套网格列定义；数值/短标签列的「表头」与「数据」一律同向对齐（右对齐），
   视觉上表头与下方数值落在同一列；第一列（校名）占宽、单行省略；窄列只给够用的宽度，其余宽度让给第一列。 */
.chartbox { border: 1rpx solid #EFF2F7; border-radius: 20rpx; padding: 20rpx 24rpx; margin: 16rpx 0 0; font-size: 25rpx; color: #33405C; }
.thead, .trow { display: grid; gap: 16rpx; align-items: center; }
.thead { font-weight: 700; color: #33405C; padding-bottom: 12rpx; border-bottom: 1rpx solid #EFF2F7; }
.trow { padding: 14rpx 0; font-size: 26rpx; color: #33405C; }
/* 三列：校名 | 所在区 | 名额（第二批招生 · 省市属高中覆盖初中） */
.thead.q3, .trow.q3 { grid-template-columns: minmax(0,1fr) 92rpx 80rpx; }
/* 两列：校名 | 名额（第二批招生 · 区属高中覆盖初中，无「所在区」列） */
.thead.q2, .trow.q2 { grid-template-columns: minmax(0,1fr) 80rpx; }
/* 三列：高中 | 名额 | 录取最低分（中考报考情况 · 录取明细） */
.thead.qt, .trow.qt { grid-template-columns: minmax(0,1fr) 80rpx 140rpx; }
.thead .tc, .trow .tc { text-align: right; }
.trow > text { min-width: 0; }
.tx { display: block; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; min-width: 0; }
/* 第一批招生（07E）：整模块一张表——表头「项目 / 计划人数」置于模块最上方（先表头，再自主招生/体育/艺术及各自二级项目）；
   一级＝通道正文行（左名定宽 / 右计划数右对齐，同 .kv），二级＝缩进的项目名 + 人数，两者数值右边缘对齐同一列 */
.kv .v.num { text-align: right; }
.sphead { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; margin-top: 22rpx; padding-bottom: 12rpx; font-size: 22rpx; font-weight: 700; color: #8B96AD; border-bottom: 1rpx solid #EFF2F7; }
.sphead .sn { flex: 1; min-width: 0; }
.sphead .sc { flex: none; }
.sublist { margin: 0 0 6rpx 24rpx; }
.subrow { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; padding: 8rpx 0; font-size: 24rpx; color: #64708C; }
.subrow .sn { flex: 1; min-width: 0; }
.subrow .sc { flex: none; }

/* 标签（行政区 / 学段 / 办学性质 / 招生方式） */
.tag { display: inline-flex; align-items: center; height: 48rpx; padding: 0 20rpx; border-radius: 12rpx; font-size: 24rpx; font-weight: 600; white-space: nowrap; flex: none; }
.tag.m { margin-left: 12rpx; }
.tag-dist { background: #EEF3FE; color: #3A62C8; }
.tag-stage { background: #E9F6FB; color: #1F7A9B; }
.tag-nature { background: #E9F7F0; color: #1F7A55; }
.tag-mech { background: #F2F6FE; color: #2F5CD6; border: 1rpx solid #98B6EC; }
