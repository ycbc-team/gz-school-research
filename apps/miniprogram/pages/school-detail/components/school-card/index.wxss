/* 学校卡组件（半窗 / 全屏 单层级）。样式隔离：本文件定义卡片容器 + 详情模块全部类。 */

/* ===== 根容器 ===== */
.scard {
  display: flex; flex-direction: column;
  background: #fff;
  box-shadow: 0 -12rpx 44rpx rgba(8,14,28,.22);
  transition: height .22s ease-out, border-radius .22s ease-out;
}
/* overlay：浮于地图页之上（底部对齐），z-index 压过地图与图例 */
.scard.overlay {
  position: absolute; left: 0; right: 0; bottom: 0; z-index: 200;
  border-radius: 36rpx 36rpx 0 0;
  padding-bottom: calc(env(safe-area-inset-bottom) + 12rpx);
}
.scard.overlay.dragging { transition: none; }       /* 跟手：关过渡 */
.scard.overlay.full { border-radius: 0; }
/* page：详情页整屏宿主，始终全屏 */
.scard.page {
  position: fixed; left: 0; right: 0; top: 0; bottom: 0; z-index: 1;
  height: 100%;
}

/* ===== 全屏态顶栏（返回 + 标题） ===== */
.stop {
  flex: none; display: flex; align-items: center; gap: 10px;
  padding: 0 98px 0 16px;
  border-bottom: 1px solid #E3E8F0; background: #fff;
}
.sback {
  width: 36px; height: 36px; border-radius: 50%;
  background: #F5F7FB; border: 1px solid #E3E8F0;
  display: flex; align-items: center; justify-content: center;
  color: #33405C; flex: none; font-size: 24px; line-height: 1; margin-top: 14px; margin-bottom: 14px;
}
/* 标题绝对居中：flex 居中会因右侧 98px 胶囊避让 padding 偏左 */
.stt {
  position: absolute; left: 50%; top: 50%; transform: translate(-50%,-50%);
  font-size: 16px; font-weight: 600; color: #10182B;
  max-width: 196px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
  margin-top: 20px; /* 避让状态栏（stop 已含 padding-top） */
}

/* ===== 半窗态 grabber + 关闭 ===== */
.sgrab {
  flex: none; width: 72rpx; height: 8rpx; border-radius: 4rpx; background: #E3E8F0;
  margin: 14rpx auto 12rpx;
}
.sclose {
  position: absolute; top: 14rpx; right: 22rpx; width: 56rpx; height: 56rpx; line-height: 52rpx; text-align: center;
  border-radius: 50%; background: #F2F4F8; color: #5A647C; font-size: 40rpx; font-weight: 600; z-index: 3;
}

/* ===== 多学段 tab 条 ===== */
.stagebar {
  flex: none; display: flex; gap: 16rpx; margin: 4rpx 24rpx 8rpx; padding: 12rpx 0 8rpx;
  background: #fff;
}
.stab {
  display: inline-flex; align-items: center; height: 60rpx; padding: 0 24rpx;
  border-radius: 999px; background: #F2F4F8; color: #5A647C;
  font-size: 25rpx; font-weight: 500; border: 1rpx solid transparent;
}
.stab.on { background: #F2F6FE; color: #254BAE; font-weight: 600; border-color: #C3D5F6; }
.stab-dot { width: 16rpx; height: 16rpx; border-radius: 50%; margin-right: 10rpx; flex: none; }
.stab.p .stab-dot { background: #2F5CD6; }
.stab.m .stab-dot { background: #E8850C; }
.stab.h .stab-dot { background: #0F9D58; }

/* ===== 内容区 ===== */
.sclip { position: relative; flex: 1; min-height: 0; overflow: hidden; padding: 0 32rpx; }
.sscroll { flex: 1; min-height: 0; padding: 4rpx 32rpx 0; box-sizing: border-box; }
.sfade {
  position: absolute; left: 0; right: 0; bottom: 0; height: 120rpx;
  background: linear-gradient(to bottom, rgba(255,255,255,0), #fff 80%); pointer-events: none;
}
.smore {
  position: absolute; right: 24rpx; bottom: calc(env(safe-area-inset-bottom) + 20rpx); z-index: 4;
  height: 68rpx; padding: 0 32rpx; border-radius: 999px;
  background: #F2F6FE; color: #254BAE; font-size: 26rpx; font-weight: 600;
  display: flex; align-items: center; border: 1rpx solid #E2EBFB;
}
.pad-bottom { height: calc(env(safe-area-inset-bottom) + 24px); }

/* ===== 详情模块（与详情页 07 同规格） ===== */
.dh1 { font-size: 40rpx; font-weight: 700; margin-top: 8rpx; color: #10182B; }
.dtags { display: flex; gap: 12rpx; margin-top: 20rpx; flex-wrap: wrap; }

.dmod { margin-top: 32rpx; padding-top: 28rpx; border-top: 1rpx solid #EFF2F7; }
.dmod-h { display: flex; align-items: baseline; justify-content: space-between; gap: 20rpx; margin-bottom: 8rpx; }
.dmod-h-t { font-size: 30rpx; font-weight: 700; color: #33405C; }
.dmod-h .dmod-meta { margin-left: auto; flex: none; font-size: 22rpx; font-weight: 400; color: #8B96AD; }

.kv { display: flex; gap: 24rpx; padding: 14rpx 0; font-size: 26rpx; line-height: 1.6; }
.kv .k { width: 216rpx; flex: none; white-space: nowrap; color: #64708C; }
.kv .v { flex: 1; min-width: 0; color: #33405C; }

.zone { font-size: 25rpx; line-height: 1.6; color: #33405C; white-space: pre-line; }

.route { display: flex; align-items: center; gap: 16rpx; padding: 14rpx 0; font-size: 25rpx; font-weight: 600; color: #33405C; }
.route .lk, .grp-row .lk { display: inline-flex; align-items: center; gap: 8rpx; color: #2F5CD6; }
.route .lk::after, .grp-row .lk::after { content: "›"; font-size: 30rpx; line-height: 1; margin-top: -4rpx; opacity: .7; }

.route-block { margin-top: 24rpx; }
.route-h { display: flex; align-items: center; gap: 16rpx; margin: 8rpx 0 14rpx; font-size: 26rpx; font-weight: 700; color: #33405C; }
.route-h .rh-n { font-weight: 700; }
.route-h .tag { margin: 0; flex: none; }

.dnote { font-size: 22rpx; color: #8B96AD; background: #F5F7FB; border-radius: 16rpx; padding: 16rpx 20rpx; margin-top: 16rpx; line-height: 1.6; }

.pubbox { border: 1rpx dashed #E3E8F0; border-radius: 20rpx; padding: 16rpx 24rpx; font-size: 24rpx; color: #64708C; margin: 16rpx 0 0; }
.grp-t { font-size: 26rpx; font-weight: 700; color: #33405C; margin: 28rpx 0 14rpx; }
.grpbox { background: #FAFBFC; border: 1rpx solid #EFF2F7; border-radius: 20rpx; padding: 16rpx 24rpx 20rpx; }
.grp-l { font-size: 26rpx; font-weight: 600; color: #64708C; margin: 12rpx 0 4rpx; }
.grp-row { display: flex; align-items: center; gap: 16rpx; padding: 14rpx 0; font-size: 25rpx; font-weight: 600; color: #33405C; }

.pill { height: 52rpx; padding: 0 24rpx; border-radius: 999px; font-size: 23rpx; font-weight: 600; display: inline-flex; align-items: center; flex: none; }
.pill.cur { background: #F2F6FE; color: #254BAE; border: 1rpx solid #C9D8F5; }

.dsub { font-size: 26rpx; font-weight: 400; color: #64708C; margin: 20rpx 0 4rpx; }
.ddiv { border-top: 3rpx dashed #E3E8F0; margin: 24rpx 0 8rpx; }

.chartbox { border: 1rpx solid #EFF2F7; border-radius: 20rpx; padding: 20rpx 24rpx; margin: 16rpx 0 0; font-size: 25rpx; color: #33405C; }
.thead { display: grid; grid-template-columns: 1fr 120rpx 168rpx; gap: 12rpx; font-weight: 700; color: #33405C; padding-bottom: 12rpx; border-bottom: 1rpx solid #EFF2F7; }
.trow { display: grid; grid-template-columns: 1fr 120rpx 168rpx; gap: 12rpx; align-items: center; padding: 14rpx 0; font-size: 26rpx; color: #33405C; }
.trow .tc { text-align: right; }
.proj { display: flex; flex-direction: column; gap: 8rpx; margin: 8rpx 0 16rpx; }
.proj-row { display: flex; gap: 32rpx; font-size: 25rpx; color: #64708C; }
.proj-row .pc { margin-left: auto; }

/* 标签（行政区 / 学段 / 办学性质 / 招生方式） */
.tag { display: inline-flex; align-items: center; height: 48rpx; padding: 0 20rpx; border-radius: 12rpx; font-size: 24rpx; font-weight: 600; white-space: nowrap; flex: none; }
.tag.m { margin-left: 12rpx; }
.tag-dist { background: #EEF3FE; color: #3A62C8; }
.tag-stage { background: #E9F6FB; color: #1F7A9B; }
.tag-nature { background: #E9F7F0; color: #1F7A55; }
.tag-mech { background: #F2F6FE; color: #2F5CD6; border: 1rpx solid #98B6EC; }
