/* 学校详情页（07 / 07B / 07C / 07D / 07E / 07F 重绘）· 知性蓝规范 */
.page { background: #ffffff; min-height: 100vh; box-sizing: border-box; }

/* 顶栏：‹ 返回 / 校名 / ✕（自定义导航，避让右上角系统胶囊） */
.dtop {
  display: flex; align-items: center; gap: 10px;
  padding: 14px 98px 14px 16px;
  border-bottom: 1px solid #E3E8F0;
  position: sticky; top: 0; z-index: 4; background: #ffffff;
}
.dtop .back, .dtop .close {
  width: 36px; height: 36px; border-radius: 50%;
  background: #F5F7FB; border: 1px solid #E3E8F0;
  display: flex; align-items: center; justify-content: center;
  color: #33405C; flex: none; font-size: 24px; line-height: 1;
}
.dtop .tt { flex: 1; text-align: center; font-size: 16px; font-weight: 600; color: #10182B; }

.dbody { padding: 0 16px 26px; }

/* 校名 + 标签 */
.dh1 { font-size: 20px; font-weight: 700; margin-top: 16px; color: #10182B; }
.dbody .dtags { display: flex; gap: 6px; margin-top: 9px; flex-wrap: wrap; }

/* 多学段 tab 条（胶囊式，吸顶于顶栏之下） */
.stagebar {
  display: flex; gap: 10px; margin: 14px -16px 2px;
  padding: 0 16px 8px; position: sticky; top: 64px; z-index: 3;
  background: #ffffff;
}
.stagebar .stab {
  flex: 1; display: inline-flex; align-items: center; justify-content: center;
  height: 34px; padding: 0 20px; border-radius: 999px;
  border: 1px solid #E3E8F0; background: #ffffff;
  font-size: 13.5px; font-weight: 600; color: #8B96AD;
}
.stagebar .stab.on { background: #F2F6FE; border-color: #98B6EC; color: #254BAE; }
.stagebar .stab-dot { display: inline-block; width: 8px; height: 8px; border-radius: 50%; margin-right: 6px; vertical-align: 1px; }
.stagebar .stab.p .stab-dot { background: #2F5CD6; }
.stagebar .stab.m .stab-dot { background: #E8850C; }
.stagebar .stab.h .stab-dot { background: #0F9D58; }

/* 模块 */
.dmod { margin-top: 16px; padding-top: 14px; border-top: 1px solid #EFF2F7; }
.dmod-h { display: flex; align-items: baseline; justify-content: space-between; gap: 10px; margin-bottom: 4px; }
.dmod-h-t { font-size: 15px; font-weight: 700; color: #33405C; }
.dmod-h .dmod-meta { margin-left: auto; flex: none; font-size: 12.5px; font-weight: 600; color: #2F5CD6; }

/* 键值行 */
.kv { display: flex; gap: 24px; padding: 7px 0; font-size: 13px; line-height: 1.6; }
.kv .k { width: 108px; flex: none; white-space: nowrap; color: #64708C; }
.kv .v { flex: 1; min-width: 0; color: #33405C; }

/* 招生地段长文本 */
.zone { font-size: 12.5px; line-height: 1.6; color: #33405C; white-space: pre-line; }

/* 升学路线 / 关联校区链接行 */
.route { display: flex; align-items: center; gap: 8px; padding: 7px 0; font-size: 12.5px; font-weight: 600; color: #33405C; }
.route .lk, .grp-row .lk { display: inline-flex; align-items: center; gap: 4px; color: #2F5CD6; }
.route .lk::after, .grp-row .lk::after { content: "›"; font-size: 15px; line-height: 1; margin-top: -2px; opacity: .7; }

/* 升学路线 · 多机制逐条「招生方式 N」行（标签紧跟左侧文案，不右对齐） */
.route-block { margin-top: 12px; }
.route-h { display: flex; align-items: center; gap: 8px; margin: 4px 0 7px; font-size: 13px; font-weight: 700; color: #33405C; }
.route-h .rh-n { font-weight: 700; }
.route-h .tag { margin: 0; flex: none; }

/* 提示框 */
.dnote { font-size: 11px; color: #8B96AD; background: #F5F7FB; border-radius: 8px; padding: 8px 10px; margin-top: 8px; line-height: 1.6; }

/* 分组容器 */
.pubbox { border: 1px dashed #E3E8F0; border-radius: 10px; padding: 9px 12px; font-size: 12px; color: #64708C; margin: 8px 0 0; }
.grp-t { font-size: 13px; font-weight: 700; color: #33405C; margin: 14px 0 7px; }
.grpbox { background: #FAFBFC; border: 1px solid #EFF2F7; border-radius: 10px; padding: 8px 12px 10px; }
.grp-l { font-size: 13px; font-weight: 600; color: #64708C; margin: 6px 0 2px; }
.grp-row { display: flex; align-items: center; gap: 8px; padding: 6px 0; font-size: 12.5px; font-weight: 600; color: #33405C; }

/* 当前查看标 */
.pill { height: 26px; padding: 0 12px; border-radius: 999px; font-size: 11.5px; font-weight: 600; display: inline-flex; align-items: center; flex: none; }
.pill.cur { background: #F2F6FE; color: #254BAE; border: 1px solid #C9D8F5; }

/* 小节标题（批次/明细表等） */
.dsub { font-size: 13px; font-weight: 400; color: #64708C; margin: 10px 0 2px; }
.ddiv { border-top: 1.5px dashed #E3E8F0; margin: 12px 0 4px; }

/* 明细表（chartbox） */
.chartbox { border: 1px solid #EFF2F7; border-radius: 10px; padding: 10px 12px; margin: 8px 0 0; font-size: 12px; color: #33405C; }
.thead { display: grid; grid-template-columns: 1fr 64px 84px; gap: 6px; font-weight: 700; color: #33405C; padding-bottom: 6px; border-bottom: 1px solid #EFF2F7; }
.trow { display: grid; grid-template-columns: 1fr 64px 84px; gap: 6px; align-items: center; padding: 7px 0; font-size: 13px; color: #33405C; }
.trow .tc { text-align: right; }
.proj { display: flex; flex-direction: column; gap: 4px; margin: 4px 0 8px; }
.proj-row { display: flex; gap: 16px; font-size: 12.5px; color: #64708C; }
.proj-row .pc { margin-left: auto; }

/* 标签（行政区 / 学段 / 办学性质 / 招生方式） */
.tag { display: inline-flex; align-items: center; height: 24px; padding: 0 10px; border-radius: 999px; font-size: 11.5px; font-weight: 600; }
.tag.m { margin-left: 6px; }
.tag-dist { background: #EEF3FE; color: #3A62C8; }
.tag-stage { background: #E9F6FB; color: #1F7A9B; }
.tag-nature { background: #E9F7F0; color: #1F7A55; }
.tag-mech { background: #F2F6FE; color: #2F5CD6; border: 1px solid #98B6EC; }

.pad-bottom { height: calc(env(safe-area-inset-bottom) + 24px); }
