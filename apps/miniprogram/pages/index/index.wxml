<view class="page {{cardFull ? 'fullview' : ''}}">
  <!-- 整屏地图背景。【常驻不销毁】原生 <map> 渲染在 WebView 之上，全屏学校详情时无法被普通 view 覆盖，
       故用 `.offscreen` 把它整体平移到视口下方（原生组件对 transform 支持不稳，这里改 top，最可靠）。
       这样全屏↔半窗切换不再触发 map 销毁/重建，省掉原生层初始化与底图重新加载的整段卡顿。
       centerLat/Lng/scale 在用户平移后会回写（onRegionChange），回到可视区时无缝复位。 -->
  <map
    id="gzmap"
    class="map {{cardFull ? 'offscreen' : ''}}"
    latitude="{{centerLat}}"
    longitude="{{centerLng}}"
    scale="{{scale}}"
    markers="{{markers}}"
    bindmarkertap="onMarkerTap"
    bindtap="onMapTap"
    bindregionchange="onRegionChange"
    show-location="{{false}}"
  ></map>

  <!-- 顶部白底常驻条（UI 稿 .topcover：状态栏 + 小程序名行，白底盖住地图，非悬浮） -->
  <view class="topcover" style="height:{{topcoverH}}px"></view>

  <!-- 顶部悬浮栏：常态为地图浮层（品牌行 + 搜索框 + 筛选栏）；
       点筛选胶囊展开时整体变为顶部白色面板窗口（搜索框上移至与胶囊同行、筛选栏即 dims、下方展开选项 + 操作），
       对应 UI 稿 04「搜索框与筛选栏整体上移 → 面板向下推出、同属一个白色窗口」 -->
  <view class="floatbar {{menu ? 'inpanel' : ''}}" style="top:{{menu ? 0 : statusBarHeight}}px;padding-top:{{menu ? statusBarHeight : 0}}px">
    <view class="brandrow {{menu ? 'hide' : ''}}">上学指南针</view>
    <view class="sbox {{menu ? 'docked' : ''}}" style="{{menu ? ('margin-right:' + searchHeadRight + 'px') : ''}}" bindtap="openSearch">
      <view class="mag"></view>
      <text class="sbox-ph">搜索广州小初高学校</text>
    </view>
    <!-- 筛选栏胶囊：常态为入口（显示维度名/选中项）；展开时即面板 dims（同 3 枚胶囊，等宽） -->
    <view class="filterrow {{menu ? 'dims' : ''}}">
      <view class="chip {{menu==='district'?'on-soft':''}}" data-dim="district" bindtap="onChipTap">
        <text>{{regionLabel}}</text>
        <view class="caret"></view>
      </view>
      <view class="chip {{menu==='stage'?'on-soft':''}}" data-dim="stage" bindtap="onChipTap">
        <text>{{stageLabel}}</text>
        <view class="caret"></view>
      </view>
      <view class="chip {{menu==='nature'?'on-soft':''}}" data-dim="nature" bindtap="onChipTap">
        <text>{{natureLabel}}</text>
        <view class="caret"></view>
      </view>
    </view>

    <!-- 面板体（仅展开时渲染，与搜索框/筛选栏同属一个白色窗口） -->
    <scroll-view wx:if="{{menu}}" scroll-y class="optscroll">
      <view wx:if="{{menu==='district'}}" class="drill">
        <scroll-view scroll-y class="dcol">
          <view class="dh">筛选维度</view>
          <view class="di {{regionDim==='district'?'on':''}}" data-dim="district" bindtap="onRegionDimTap">行政区/板块<text class="cr">›</text></view>
          <view class="di {{regionDim==='metro'?'on':''}}" data-dim="metro" bindtap="onRegionDimTap">地铁<text class="cr">›</text></view>
        </scroll-view>
        <scroll-view scroll-y class="dcol">
          <view class="dh">{{col2Header}}</view>
          <block wx:if="{{regionDim==='district'}}">
            <view wx:for="{{districts}}" wx:key="adcode" class="di {{item.checked?'on':''}}" data-adcode="{{item.adcode}}" bindtap="toggleDistrict">{{item.name}}<text wx:if="{{item.adcode===focusDistrict}}" class="cr">›</text></view>
          </block>
          <block wx:else>
            <view wx:for="{{metroLines}}" wx:key="id" class="di {{item.checked?'on':''}} {{item.id===focusLine?'fcs':''}}" data-id="{{item.id}}" bindtap="focusLineTap">{{item.name}}<text wx:if="{{item.id===focusLine}}" class="cr">›</text></view>
          </block>
        </scroll-view>
        <scroll-view scroll-y class="dcol">
          <view class="dh">{{col3Header}}</view>
          <block wx:if="{{regionDim==='district'}}">
            <view class="di feat {{allPlateOn?'on':''}}" data-ad="{{focusDistrict}}" bindtap="toggleAllPlates">全部{{focusDistrictName}}</view>
            <view wx:for="{{plateCol}}" wx:key="id" class="di {{item.checked?'on':''}}" data-id="{{item.id}}" bindtap="togglePlate">{{item.name}}</view>
          </block>
          <block wx:else>
            <view wx:for="{{stationCol}}" wx:key="id" class="di {{item.checked?'on':''}}" data-id="{{item.id}}" bindtap="toggleStation">{{item.name}}</view>
          </block>
        </scroll-view>
      </view>
      <view wx:if="{{menu==='stage'}}" class="optgroups">
        <view class="optgrp">
          <view class="ghd">小学</view>
          <view class="opts"><view class="opt {{stagePri?'on':''}}" data-stage="primary" bindtap="toggleStage">小学</view></view>
        </view>
        <view class="optgrp">
          <view class="ghd">初中</view>
          <view class="opts"><view class="opt {{stageMid?'on':''}}" data-stage="middle" bindtap="toggleStage">初中</view></view>
        </view>
        <view class="optgrp">
          <view class="ghd">高中</view>
          <view class="opts">
            <view class="opt {{hM?'on':''}}" data-grade="hM" bindtap="toggleGrade">省市属示范</view>
            <view class="opt {{hD?'on':''}}" data-grade="hD" bindtap="toggleGrade">区属示范</view>
            <view class="opt {{hN?'on':''}}" data-grade="hN" bindtap="toggleGrade">其他学校</view>
          </view>
        </view>
      </view>
      <view wx:if="{{menu==='nature'}}" class="opts">
        <view wx:for="{{SCHOOL_NATURE_TABS}}" wx:key="v" class="opt {{item.checked?'on':''}}" data-nature="{{item.v}}" bindtap="toggleNature">{{item.l}}</view>
      </view>
    </scroll-view>
    <view wx:if="{{menu && menu !== 'district'}}" class="sfoot">
      <view class="none" bindtap="clearDim">全不选</view>
      <view class="ok" bindtap="confirmSheet">确认</view>
    </view>
    <!-- 区域弹窗（底部右对齐）：重置 → 清空行政区/板块/地铁选择，展示 7 个区全部学校 -->
    <view wx:if="{{menu === 'district'}}" class="sfoot sfoot-reset">
      <view class="reset" bindtap="resetRegion">重置</view>
    </view>
  </view>

  <!-- 蒙层：仅筛选展开时显示，压暗地图、点击收起面板（不保存改动） -->
  <view wx:if="{{menu}}" class="mask" bindtap="closeSheet"></view>

  <!-- 图例区：位置固定不变（学校卡弹出时被卡片盖住，不移动） -->
  <view class="legend">
    <view class="lg"><view class="lg-dot" style="background:#2F5CD6"></view>小学</view>
    <view class="lg"><view class="lg-dot" style="background:#E8850C"></view>初中</view>
    <view class="lg"><view class="lg-dot" style="background:#0F9D58"></view>高中</view>
    <view class="lg"><view class="lg-dot lg-multi"></view>多学段</view>
  </view>

  <!-- 学校卡（分包组件，context=overlay 浮于地图之上）：半窗 / 全屏 单层级原位生长。
       主包仅传最小标识（校名 / 实体 id / 初始学段）；渲染与半窗↔全屏生长全在组件内。
       分包就绪（wx.loadSubpackage success）前不渲染任何占位——未就绪点学校由页面弹「学校信息加载中」toast；
       ✕ 关闭 → bindclose；关联校区跳转 → bindgoto。
       注：componentPlaceholder("view") 为主包页引用分包组件的编译硬性要求，wx:if 门控下永不显示。 -->
  <school-card wx:if="{{card && subReady}}" context="overlay" schoolId="{{card.schoolId}}" name="{{card.name}}" stage="{{card.stage}}" bindclose="closeCard" bindgoto="onCardGoto" bindmodechange="onCardMode" />

  <!-- 筛选结果为空 · 地图中央浮层（UI 稿异常态 C：不遮挡地图手势，点浮层外关闭浮层保留筛选） -->
  <view wx:if="{{filterEmpty}}" class="fempty">
    <view class="fempty-t">当前筛选下无匹配学校</view>
    <view class="fempty-d">试试取消部分筛选条件</view>
    <view class="fempty-d">或扩大行政区范围</view>
    <view class="fempty-btn" catchtap="resetFilters">重置筛选</view>
  </view>

  <!-- 搜索页（全屏层） -->
  <view wx:if="{{searchVisible}}" class="searchpage">
    <view class="searchhead" style="padding-top:{{searchHeadTop}}px;padding-right:{{searchHeadRight}}px">
      <!-- 返回：全局唯一返回按钮（.gback，同学校详情页全屏顶栏），top 使其与 44px 头行垂直居中 -->
      <view class="gback" style="top:{{searchHeadTop + 6}}px" bindtap="closeSearch"><view class="gback-chev"></view></view>
      <view class="sip {{kw?'typed':''}}">
        <view class="mag"></view>
        <input class="sinput" focus="{{searchFocus}}" placeholder="支持广州小初高学校搜索" placeholder-class="ph" value="{{kw}}" confirm-type="search" bindinput="onSearchInput" bindconfirm="onSearchConfirm" />
      </view>
      <view class="sgo {{kw?'show':''}}" bindtap="onSearchConfirm">搜索</view>
    </view>
    <scroll-view scroll-y class="sbody">
      <block wx:if="{{!kw}}">
        <view wx:if="{{history.length}}" class="sblock">
          <view class="shd"><text class="sht">历史记录</text><text class="clr" bindtap="clearHistory">清空</text></view>
          <view class="pillwrap">
            <view wx:for="{{history}}" wx:key="*this" class="pill" data-kw="{{item}}" bindtap="tapHistory">{{item}}</view>
          </view>
        </view>
        <view class="sblock">
          <view class="shd"><text class="sht">快速搜索省市属高中（按拼音首字母排序）</text></view>
          <view class="slist">
            <view wx:for="{{recommends}}" wx:key="name" class="srow" data-name="{{item.name}}" bindtap="tapRecommend">
              <text class="nm">{{item.name}}</text>
            </view>
          </view>
        </view>
      </block>
      <block wx:else>
        <view class="sug">
          <!-- 词条右侧标签：行政区固定带「区」字；多学段学校按学段拆成多枚标签，不合并为一枚 -->
          <view wx:for="{{assocs}}" wx:key="name" class="srow" data-idx="{{index}}" bindtap="pickAssoc">
            <text class="nm">{{item.name}}</text>
            <view class="tag tag-dist">{{item.district}}</view>
            <view wx:for="{{item.stages}}" wx:for-item="st" wx:key="*this" class="tag tag-stage">{{st}}</view>
          </view>
          <view wx:if="{{!assocs.length}}" class="sempty">
            <view class="sempty-ico"><view class="sempty-mag"></view></view>
            <view class="sempty-t">未找到相关学校</view>
            <view class="sempty-d">没有找到与「{{kw}}」匹配的学校</view>
            <view class="sempty-d">试试换个关键词，或放宽筛选条件</view>
            <view class="sempty-btn" bindtap="clearAndResearch">清空并重新搜索</view>
          </view>
        </view>
      </block>
    </scroll-view>
  </view>
</view>
