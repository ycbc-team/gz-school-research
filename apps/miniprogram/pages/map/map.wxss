.page { padding: 24rpx; }
.toolbar { display: flex; flex-wrap: wrap; gap: 16rpx; margin-bottom: 16rpx; }
.chip {
  border: 1rpx solid #d6d4cc; background: #fff; color: #1a1b1c;
  border-radius: 999rpx; padding: 10rpx 24rpx; font-size: 26rpx;
}
.chip.active { background: #3a5396; border-color: #3a5396; color: #fff; }
.info { font-size: 24rpx; color: #6b7280; margin-bottom: 16rpx; }
.map { width: 100%; height: 800rpx; border-radius: 20rpx; overflow: hidden; }
