<view class="page">
  <!-- map 新基础库支持同层渲染，浮层用普通 view（cover-view 不支持 input / flex gap，真机会错位） -->
  <map
    id="gzmap"
    class="map"
    latitude="{{centerLat}}"
    longitude="{{centerLng}}"
    scale="{{scale}}"
    markers="{{markers}}"
    bindmarkertap="onMarkerTap"
    bindtap="onMapTap"
    bindregionchange="onRegionChange"
  ></map>

  <!-- 顶部控件：搜索 + 三级筛选 -->
  <view class="top">
    <view class="search-bar">
      <input
        class="search-input"
        placeholder="搜索学校名，如：华南师范大学附属中学"
        placeholder-class="ph"
        value="{{kw}}"
        confirm-type="search"
        bindinput="onSearchInput"
      />
      <view wx:if="{{searchOpen && searchResults.length}}" class="search-drop">
        <view
          wx:for="{{searchResults}}"
          wx:key="name"
          class="s-item"
          data-idx="{{index}}"
          bindtap="pickResult"
        >{{item.name}}</view>
        <view wx:if="{{searchOpen && kw && !searchResults.length}}" class="s-empty">无匹配学校</view>
      </view>
    </view>

    <view class="filter-bar">
      <view class="fb-btn {{menu === 'district' ? 'on' : ''}}" data-menu="district" bindtap="toggleMenu">
        区域<view wx:if="{{!districtAll}}" class="fb-badge">{{selectedDistricts.length}}</view><view class="arr">▾</view>
      </view>
      <view class="fb-btn {{menu === 'stage' ? 'on' : ''}}" data-menu="stage" bindtap="toggleMenu">
        学段<view wx:if="{{!stageAll}}" class="fb-badge">{{selectedStages.length}}</view><view class="arr">▾</view>
      </view>
      <view class="fb-btn {{menu === 'grade' ? 'on' : ''}}" data-menu="grade" bindtap="toggleMenu">
        分级<view wx:if="{{!gradeAll}}" class="fb-badge">{{selectedGrades.length}}</view><view class="arr">▾</view>
      </view>
    </view>

    <!-- 区域多选 -->
    <view wx:if="{{menu === 'district'}}" class="fb-pop">
      <view class="chips">
        <view
          wx:for="{{districts}}"
          wx:key="adcode"
          class="chip {{item.checked ? 'on' : ''}}"
          data-adcode="{{item.adcode}}"
          bindtap="toggleDistrictAd"
        >{{item.short}}</view>
      </view>
      <view class="pop-foot">
        <view class="pop-link" bindtap="flipAllDistricts">{{districtAll ? '全不选' : '全选'}}</view>
        <view class="pop-link" bindtap="closeMenu">完成</view>
      </view>
    </view>

    <!-- 学段多选 -->
    <view wx:if="{{menu === 'stage'}}" class="fb-pop">
      <view class="chips">
        <view
          wx:for="{{STAGE_TABS}}"
          wx:key="v"
          class="chip {{item.checked ? 'on' : ''}}"
          data-stage="{{item.v}}"
          bindtap="toggleStageTab"
        >{{item.l}}</view>
      </view>
      <view class="pop-foot">
        <view class="pop-link" bindtap="flipAllStages">{{stageAll ? '全不选' : '全选'}}</view>
        <view class="pop-link" bindtap="closeMenu">完成</view>
      </view>
    </view>

    <!-- 分级多选（分组） -->
    <view wx:if="{{menu === 'grade'}}" class="fb-pop">
      <view wx:for="{{GRADE_GROUPS}}" wx:key="title" class="pop-group">
        <view class="pop-group-title">{{item.title}}</view>
        <view class="chips">
          <view
            wx:for="{{item.items}}"
            wx:for-item="o"
            wx:key="v"
            class="chip {{o.checked ? 'on' : ''}}"
            data-cls="{{o.v}}"
            bindtap="toggleGradeCls"
          >{{o.l}}</view>
        </view>
      </view>
      <view class="pop-foot">
        <view class="pop-link" bindtap="flipAllGrades">{{gradeAll ? '全不选' : '全选'}}</view>
        <view class="pop-link" bindtap="closeMenu">完成</view>
      </view>
    </view>
  </view>

  <!-- 底部信息卡（无黑蒙层；点击地图空白处关闭） -->
  <view
    wx:if="{{info}}"
    class="drawer {{drawerDragging ? 'drawer-dragging' : ''}}"
    style="transform: translateY({{drawerOffset}}px);"
    bindtouchstart="onDrawerTouchStart"
    bindtouchmove="onDrawerTouchMove"
    bindtouchend="onDrawerTouchEnd"
    bindtouchcancel="onDrawerTouchEnd"
  >
    <view class="handle"></view>
    <scroll-view class="drawer-content" scroll-y="true" bindscroll="onDrawerScroll">
      <view class="d-head">
        <view class="d-name">{{info.name}}</view>
        <view class="d-close" bindtap="closeInfo">×</view>
      </view>
      <view class="d-badges">
        <view wx:for="{{info.badges}}" wx:key="cls" class="badge {{item.cls}}">{{item.text}}</view>
      </view>
      <view wx:if="{{info.head}}" class="d-subhead">{{info.head}}</view>
      <view wx:for="{{info.rows}}" wx:key="label" class="d-row">
        <view class="d-label">{{item.label}}</view>
        <view class="d-value {{item.label === '招生地段' || item.label === '升学路线' ? 'd-clamp' : ''}}">{{item.value}}</view>
      </view>
      <view wx:if="{{info.note}}" class="d-note">{{info.note}}</view>
      <view wx:for="{{info.links}}" wx:key="to" class="d-link" data-to="{{item.to}}" bindtap="goDetail">{{item.text}}</view>
    </scroll-view>
  </view>
</view>
